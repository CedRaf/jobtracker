# Copy to .env.local (gitignored) for local development.
# Both values are safe in the browser: row-level security protects the data.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_PASTE_FROM_PROJECT_SETTINGS_API_KEYS

# true = run on built-in sample data with no Supabase (public demo, local UI work).
VITE_DEMO=false
